rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Web admin đọc realtime (onSnapshot). Ghi luôn đi qua backend FastAPI
    // (Firebase Admin SDK — bỏ qua rules), nên client không cần quyền write.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /drivers/{driverId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /maintenance_schedules/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /music_tracks/{trackId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Mặc định chặn hết phần còn lại.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
