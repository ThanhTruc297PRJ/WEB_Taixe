rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Ảnh/clip sự cố: app tài xế ghi qua backend (Admin SDK — bỏ qua rules),
    // web admin đọc trực tiếp qua URL tải (có download token). Token uuid4
    // không đoán được nên coi như "unlisted", đủ cho nhu cầu xem trên web.
    match /incident_snapshots/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /incident_clips/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Ảnh tài xế đính kèm khi tự gửi báo cáo từ app — cũng chỉ backend ghi.
    match /driver_reports/{uid}/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Ảnh đại diện admin: chỉ chính chủ (đúng uid + có claim admin) mới ghi
    // được vào thư mục của mình. Đọc công khai — giống cách incident media
    // đang xử lý, ảnh đại diện không phải dữ liệu nhạy cảm.
    match /admin_avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.admin == true;
    }

    // Ảnh đại diện tài xế: chỉ chính chủ (đúng uid, không cần claim admin —
    // tài khoản tài xế) mới ghi được vào thư mục của mình. Đọc công khai.
    match /driver_avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
